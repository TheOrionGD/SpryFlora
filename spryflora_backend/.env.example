# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (Replace with your local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://localhost:27017/spryflora_db

# Authentication Security (Replace with a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=14d

# AI Provider Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO FLUTTER APP)
# Segment 1 Key: Photo Analysis, Diagnostics & Stage Guidance
GEMINI_API_KEY_1=your_gemini_api_key_1_here
# Segment 2 Key: Flora AI Q&A Chatbot & Daily Assistant
GEMINI_API_KEY_2=your_gemini_api_key_2_here
# Primary Fallback Gemini Key
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Hugging Face Vision Inference Model Key
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Grok (xAI) Reasoning Provider Key
GROK_API_KEY=your_grok_api_key_here

AI_BACKEND_ENABLED=true

# Security & CORS Configuration (Comma-separated origins or * for development)
CORS_ORIGINS=*
