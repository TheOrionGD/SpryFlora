# ==============================================================================
# Comprehensive .gitignore for Flutter / Multiplatform Application
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ------------------------------------------------------------------------------
# Flutter & Dart Common
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
**/doc/api/
*.lock
!pubspec.lock

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Widget Preview
.widget_preview/

# ------------------------------------------------------------------------------
# Android
# ------------------------------------------------------------------------------
**/android/.gradle/
**/android/local.properties
**/android/**/build/
**/android/captures/
**/android/.cxx/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.apk
*.aab
*.ap_
*.dex
*.class

# Android Signing / Keystore (protect credentials)
*.keystore
*.jks
key.properties

# ------------------------------------------------------------------------------
# iOS & macOS
# ------------------------------------------------------------------------------
**/ios/Flutter/.last_build_id
**/ios/Flutter/ephemeral/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Pods/
**/ios/.symlinks/
**/ios/profile/
**/ios/release/
**/ios/DerivedData/
**/ios/**/xcuserdata/
**/ios/*.xcworkspace/xcuserdata/
**/ios/*.xcodeproj/xcuserdata/
**/ios/*.xcodeproj/project.xcworkspace/xcuserdata/

**/macos/Flutter/ephemeral/
**/macos/Pods/
**/macos/.symlinks/
**/macos/DerivedData/
**/macos/**/xcuserdata/

# ------------------------------------------------------------------------------
# Windows
# ------------------------------------------------------------------------------
**/windows/flutter/ephemeral/
**/windows/build/
**/windows/runner/Debug/
**/windows/runner/Release/
**/windows/runner/Profile/
*.vcxproj.user
*.vcxproj.filters

# ------------------------------------------------------------------------------
# Linux
# ------------------------------------------------------------------------------
**/linux/flutter/ephemeral/
**/linux/build/
**/linux/cmake-build-*/

# ------------------------------------------------------------------------------
# Web
# ------------------------------------------------------------------------------
**/build/web/

# ------------------------------------------------------------------------------
# IDEs and Text Editors
# ------------------------------------------------------------------------------
# IntelliJ / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Sublime Text / Eclipse / Atom / Fleet
*.sublime-workspace
*.sublime-project
.atom/
.fleet/
.history/
.project
.classpath
.settings/

# ------------------------------------------------------------------------------
# Logs, Temporary & Cache Files
# ------------------------------------------------------------------------------
*.log
*.log.*
*.tmp
*.temp
*.bak
*.swp
*.swo
.cache/
migrate_working_dir/

# ------------------------------------------------------------------------------
# Secrets & Environment Variables (Keep API keys private)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
google-services.json
GoogleService-Info.plist
